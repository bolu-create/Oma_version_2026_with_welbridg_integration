# Oma — environment variables
# Locally: copy to .env (git-ignored) and fill in. On Railway: set these as
# service Variables (no .env file is deployed).

# ── Models (Anthropic, via its OpenAI-compatible endpoint) ──────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                 # still read at import by some modules; any value works
# Optional overrides, see app/services/oma_models.py
# OMA_MODEL_MAIN=claude-opus-5-5
# OMA_MODEL_WORKER=claude-sonnet-5-5
# OMA_MODEL_FAST=claude-haiku-5-5

# ── Database (MySQL) ────────────────────────────────────────────────────────
# On Railway use the private host (mysql.railway.internal:3306).
# Locally use the public TCP proxy host and port.
SQL_HOST_SERVER=
DB_PORT=3306
DB_DATABASE=
MY_USERNAME=
PASSWORD=

# ── File storage (Cloudflare R2) ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# ACCESS_TOKEN from Meta App Dashboard > API Setup (or a System User token).
ACCESS_TOKEN=
APP_ID=
APP_SECRET=
VERSION=v18.0
PHONE_NUMBER_ID=
VERIFY_TOKEN=

# ── Web chat (Welbridg site) ────────────────────────────────────────────────
# The Supabase project the Welbridg site logs users into; Oma verifies their
# login token against it. Public values (the same ones the site uses).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated site origins allowed to call /web/*
WEB_ALLOWED_ORIGINS=http://localhost:5173

# ── Gmail (service account) ─────────────────────────────────────────────────
# Deployed: paste the whole contents of welbridg-agent.json as one value.
# Locally: leave unset and keep welbridg-agent.json (git-ignored) in the
# project root.
# GOOGLE_SERVICE_ACCOUNT_JSON=
